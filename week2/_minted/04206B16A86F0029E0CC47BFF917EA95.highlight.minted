\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} 优化前：列表线性搜索 O(N\PYGZca{}2)}
\PYG{n}{unique} \PYG{o}{=} \PYG{p}{[]}
\PYG{k}{for} \PYG{n}{word} \PYG{o+ow}{in} \PYG{n}{words}\PYG{p}{:}
    \PYG{k}{if} \PYG{n}{word} \PYG{o+ow}{not} \PYG{o+ow}{in} \PYG{n}{unique}\PYG{p}{:}
        \PYG{n}{unique}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{word}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} 优化后：哈希集合 O(N)}
\PYG{n}{unique} \PYG{o}{=} \PYG{n+nb}{set}\PYG{p}{()}
\PYG{k}{for} \PYG{n}{word} \PYG{o+ow}{in} \PYG{n}{words}\PYG{p}{:}
    \PYG{n}{unique}\PYG{o}{.}\PYG{n}{add}\PYG{p}{(}\PYG{n}{word}\PYG{p}{)}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}count=\PYGZdq{}}\PYG{p}{,} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{unique}\PYG{p}{))}
\end{MintedVerbatim}
